# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Edge Function Secret ───────────────────────────────────────────────────────
# Shared secret between frontend and Supabase Edge Functions.
# Set the same value in Supabase → Edge Functions → Secrets as FLOWPAY_SECRET.
VITE_FLOWPAY_SECRET=your-secret-here
