# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtén estos valores en: supabase.com → tu proyecto → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Edge Function Secret ───────────────────────────────────────────────────────
# Secreto compartido entre el frontend y las Edge Functions.
# Configura el mismo valor en Supabase → Edge Functions → Secrets como FLOWPAY_SECRET.
VITE_FLOWPAY_SECRET=your-secret-here

# ── Wallet de la empresa ───────────────────────────────────────────────────────
# Dirección pública (Base58) de la wallet que firma los pagos de nómina.
# Solo la dirección pública — la clave privada va en los Secrets de Supabase.
VITE_EMPRESA_WALLET_ADDRESS=your-empresa-wallet-pubkey

# ── URL de la aplicación ───────────────────────────────────────────────────────
# En desarrollo local: http://localhost:5173
# En producción:       https://your-app.vercel.app
VITE_APP_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS DE SUPABASE EDGE FUNCTIONS (NO van aquí — se configuran en Supabase)
# ─────────────────────────────────────────────────────────────────────────────
# Supabase → Dashboard → Edge Functions → Manage secrets:
#
#   GROQ_API_KEY              → Tu API key de Groq (console.groq.com)
#   FLOWPAY_SECRET            → Mismo valor que VITE_FLOWPAY_SECRET
#   FLOWPAY_CRON_SECRET       → Secreto exclusivo para pg_cron (distinto al anterior)
#   EMPRESA_WALLET_PRIVATE_KEY → Clave privada Base58 de la wallet empresa
#
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY son inyectados automáticamente.
# ─────────────────────────────────────────────────────────────────────────────
